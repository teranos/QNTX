{
  "plugins": [
    {
      "name": "github",
      "version": "0.9.3",
      "qntx_version": "0.52.0",
      "description": "The node’s GitHub (ADR-043)",
      "author": "sbvh-nl",
      "license": "MIT",
      "healthy": true,
      "probed": true,
      "state": "running",
      "pausable": true,
      "sigils": [
        {
          "signum": "github",
          "sigil": "status",
          "tool": "github_status",
          "method": "GET",
          "path": "/api/github",
          "does": "The node’s GitHub: its switch, each namespace’s token, and the Actions runner.",
          "takes": [
            {
              "name": "namespace",
              "says": "one namespace, or every one the viewer reaches",
              "required": false
            }
          ],
          "gives": [
            {
              "name": "enabled",
              "says": "whether GitHub is on for the node"
            }
          ],
          "reach": {
            "http": {
              "anyone": false,
              "levels": [
                "SUPER"
              ],
              "roles": [
                "operator"
              ]
            },
            "mcp": {
              "anyone": false,
              "levels": [
                "SUPER"
              ],
              "roles": []
            },
            "a2a": {
              "anyone": false,
              "levels": [],
              "roles": []
            }
          }
        }
      ],
      "repo": "https://github.com/sbvh-nl/qntx-github-plugin",
      "enabled": true
    }
  ]
}
